meta {
  name: Alma Link Resolver - Availability by DOI
  type: http
  seq: 7
}

get {
  url: {{almaResolverBaseUrl}}/{{almaInstitution}}/openurl?ctx_ver=Z39.88-2004&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft_id=info:doi/{{doi}}&svc_dat=CTO
  body: none
  auth: none
}

params:query {
  ctx_ver: Z39.88-2004
  rft_val_fmt: info:ofi/fmt:kev:mtx:journal
  rft.genre: article
  rft_id: info:doi/{{doi}}
  svc_dat: CTO
}

script:pre-request {
  // Like _crossref_openurl_fields in the backend: the citation from Crossref goes
  // along, since the resolver checks the licences by ISSN, year and volume.
  // bru.sendRequest instead of axios: require() isn't available in Safe Mode.
  const doi = bru.interpolate("{{doi}}");
  const crossref = bru.interpolate("{{crossrefBaseUrl}}");
  const mailto = encodeURIComponent(bru.interpolate("{{mailto}}"));
  const response = await bru.sendRequest({
    method: "GET",
    url: `${crossref}/works/${encodeURIComponent(doi)}?mailto=${mailto}`,
  });
  const work = response.data.message;

  const issns = Object.fromEntries((work["issn-type"] || []).map((e) => [e.type, e.value]));
  const issued = ((work.issued || {})["date-parts"] || [[]])[0];
  const fields = {
    "rft.atitle": (work.title || [])[0],
    "rft.issn": issns.print || (work.ISSN || [])[0],
    "rft.eissn": issns.electronic,
    "rft.date": issued[0] ? String(issued[0]) : undefined,
    "rft.volume": work.volume,
    "rft.issue": work.issue,
    "rft.spage": (work.page || "").split("-")[0],
  };

  const query = Object.entries(fields)
    .filter(([, value]) => value)
    .map(([key, value]) => `${key}=${encodeURIComponent(value)}`)
    .join("&");
  req.setUrl(`${req.getUrl()}&${query}`);
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a context object", function() {
    expect(res.getBody()).to.include("<uresolver_content");
    expect(res.getBody()).to.include('<key id="full_text_indicator">');
  });

  test("ISSN reached the resolver", function() {
    expect(res.getBody()).to.include('<key id="rft.issn">');
  });
}

docs {
  Fragt beim Alma-Link-Resolver ab, ob und wie ein Paper über die Bibliothek
  verfügbar ist, mit denselben Parametern wie `_openurl` im Backend. Mit
  `svc_dat=CTO` liefert er XML statt auf Primo weiterzuleiten.

  - `almaInstitution` in der Environment: `49HBZ_FSW` (FH SWF, `OPENURL_RESOLVER`)
    oder `49HBZ_ULM` (Uni Münster, `OPENURL_RESOLVERS_BY_DOMAIN`).
  - Das Pre-Request-Script holt zur `doi` die Zitation bei Crossref und hängt
    ISSN, Jahr, Band, Heft, Startseite und Artikeltitel an. Den Zeitschriftentitel
    nicht: den gleicht der Resolver unscharf ab. Mit der DOI allein prüft Alma
    gar keine Lizenzen.
  - `full_text_indicator`: `true`, wenn es irgendeinen Volltext gibt.
  - Je Zugriffsweg ein `<context_service service_type="...">`:
    `getFullTxt` (über die Bibliothek lizenziert), `getOpenAccessFullText` (frei),
    `getHolding` (Printbestand). Mit `package_display_name` und `target_url`.
    `<key id="Filtered">true` heißt: Paket gefunden, deckt den Artikel aber nicht
    ab (z. B. außerhalb des lizenzierten Zeitraums).
  - Kein API-Key nötig. Inoffiziell: `svc_dat=CTO` ist bei Ex Libris nur als
    Debugging-Hilfe beschrieben, Format und Verfügbarkeit sind nicht zugesichert.
}
